# ============================================================
# Telegram Bot Token (from @BotFather)
# ============================================================
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ============================================================
# AI 提供商配置（任选一个填写即可，按优先级自动识别）
# ============================================================
# 用法：只需填一个你有的 API Key，系统自动识别
# 优先级：DeepSeek > OpenAI > Anthropic Claude

# --- 方式1: Google Gemini（免费额度，推荐）---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GEMINI_MODEL=gemini-2.5-flash

# --- 方式2: DeepSeek（国产，推荐，高性价比）---
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# DEEPSEEK_MODEL=deepseek-chat

# --- 方式2: OpenAI ChatGPT ---
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# OPENAI_MODEL=gpt-4o

# --- 方式3: Anthropic Claude ---
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# CLAUDE_MODEL=claude-sonnet-4-6

# --- 方式4: 其他 OpenAI 兼容的 API（豆包/通义千问/Moonshot等）---
# CUSTOM_API_KEY=YOUR_CUSTOM_API_KEY_HERE
# CUSTOM_API_BASE_URL=https://your-api-endpoint.com/v1
# CUSTOM_MODEL=your-model-name

# --- 手动指定 AI 提供商（可选，默认 auto 自动选择）---
# AI_PROVIDER=auto
